# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python (hvis du kører lokal server)
__pycache__/
*.py[cod]
*$py.class
.Python

# Editor filer
.vscode/
.idea/
*.swp
*.swo
*~

# Temp/test filer
*.tmp
.cache/

# Logs
*.log

# Bog-byg output
tools/output/_*.tex
tools/output/_*.lua

# Cached SVG → PDF konverteringer (regenereres af rsvg-convert ved hver kørsel
# og er ikke deterministiske byte-for-byte — så de er ikke meningsfulde at
# tracke i git. byg_bog.py regenererer dem automatisk fra hero-motiver/*.svg)
tools/output/figures/*.pdf
tools/output/figures/*.png

# Auto-genererede trio-side-SVG'er (én pr. kapitel) — bygges af
# render_invitationer_trio() ud fra mikrotekster.json ved hver kørsel
tools/output/figures/_invitationer-kap-*.svg
